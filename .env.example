# ==========================================
# Environment Variables Template
# Copy this file to .env and configure values.
# NEVER commit .env to version control!
# ==========================================

# Optional: Steam Web API Key (required for private profiles or official schema retrieval)
# Get your key at: https://steamcommunity.com/dev/apikey
STEAM_WEB_API_KEY=your_steam_api_key_here

# Optional: Custom Steam Installation Directory (auto-detected via Windows Registry if empty)
# Default: C:\Program Files (x86)\Steam
STEAM_INSTALL_PATH=C:\Program Files (x86)\Steam

# Logging Level: Debug | Information | Warning | Error
LOG_LEVEL=Information
