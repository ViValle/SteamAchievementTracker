# ==========================================
# .gitignore for .NET & Visual Studio / JetBrains
# ==========================================

# Build results
[Bb]in/
[Oo]bj/
dist/
build/
out/
[Dd]ebug/
[Rr]elease/
*.exe
*.dll
*.so
*.dylib
*.pdb
*.old
*.old*

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# Visual Studio / Rider / VS Code cache
.vs/
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
*.patch

# Temporary files & logs
*.log
*.dmp
*.tmp
*.temp
_ReSharper*/

# Environment and Secrets
.env
.env.*
!.env.example

# Windows shortcuts & artifacts
*.lnk
Thumbs.db
ehthumbs.db
[Dd]esktop.ini

# Test results
TestResults/
[Tt]est[Rr]esult*
*.coverage
*.coveragexml
