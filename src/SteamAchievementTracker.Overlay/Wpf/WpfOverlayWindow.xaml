<Window x:Class="SteamAchievementTracker.Overlay.Wpf.WpfOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Achievement Overlay"
        Width="520"
        MinWidth="460"
        MaxWidth="620"
        MinHeight="92"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        Focusable="False"
        ShowActivated="False"
        WindowStartupLocation="Manual">
    <Window.Resources>
        <Storyboard x:Key="SlideInStoryboard">
            <DoubleAnimation Storyboard.TargetName="RootBorder"
                             Storyboard.TargetProperty="Opacity"
                             From="0.0" To="1.0" Duration="0:0:0.35">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="RootTransform"
                             Storyboard.TargetProperty="Y"
                             From="-40" To="0" Duration="0:0:0.38">
                <DoubleAnimation.EasingFunction>
                    <BackEase EasingMode="EaseOut" Amplitude="0.25"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <Storyboard x:Key="SlideOutStoryboard">
            <DoubleAnimation Storyboard.TargetName="RootBorder"
                             Storyboard.TargetProperty="Opacity"
                             From="1.0" To="0.0" Duration="0:0:0.32">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseIn"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="RootTransform"
                             Storyboard.TargetProperty="Y"
                             From="0" To="-40" Duration="0:0:0.35">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseIn"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </Window.Resources>

    <Grid>
        <Border x:Name="RootBorder"
                Background="#F0131620"
                CornerRadius="14"
                BorderThickness="1.8"
                BorderBrush="#FFD700"
                Margin="12,6,12,12"
                Padding="12,10,14,10"
                Opacity="0">
            <Border.RenderTransform>
                <TranslateTransform x:Name="RootTransform" Y="-40"/>
            </Border.RenderTransform>

            <Border.Effect>
                <DropShadowEffect x:Name="GlowEffect"
                                  Color="#FFD700"
                                  BlurRadius="24"
                                  ShadowDepth="0"
                                  Opacity="0.85"/>
            </Border.Effect>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Иконка ачивки -->
                <Border Grid.Column="0"
                        Width="56" Height="56"
                        CornerRadius="8"
                        ClipToBounds="True"
                        BorderBrush="#44FFFFFF"
                        BorderThickness="1"
                        Background="#1E2330"
                        VerticalAlignment="Center"
                        Margin="0,0,12,0">
                    <Image x:Name="IconImage" Stretch="UniformToFill"/>
                </Border>

                <!-- Текстовая колонка с динамическим переносом текста -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                        <TextBlock x:Name="RankBadgeText"
                                   Text="ЗОЛОТО"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   Foreground="#FFD700"
                                   Margin="0,0,8,0"/>
                        <TextBlock x:Name="RarityPercentageText"
                                   Text="• 12.4% игроков"
                                   FontSize="10"
                                   Foreground="#88FFFFFF"/>
                    </StackPanel>

                    <TextBlock x:Name="TitleText"
                               Text="Название достижения"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="#FFFFFF"
                               TextWrapping="Wrap"
                               Margin="0,0,0,3"/>

                    <TextBlock x:Name="DescriptionText"
                               Text="Описание полученного достижения"
                               FontSize="11.5"
                               Foreground="#C2C9D8"
                               TextWrapping="Wrap"
                               LineHeight="16"/>
                </StackPanel>

                <!-- Символ ранга справа -->
                <Border Grid.Column="2"
                        VerticalAlignment="Center"
                        CornerRadius="6"
                        Padding="7,4"
                        Background="#1EFFFFFF"
                        Margin="4,0,0,0">
                    <TextBlock x:Name="RankIconText"
                               Text="🏆"
                               FontSize="15"/>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
