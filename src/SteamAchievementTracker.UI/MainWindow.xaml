<Window x:Class="SteamAchievementTracker.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:SteamAchievementTracker.UI.ViewModels"
        Title="Steam Achievement Overlay &amp; Tracker"
        Icon="app_icon.ico"
        Width="1180" Height="780"
        MinWidth="980" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="#0E1017"
        Foreground="#ECEFF4">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <!-- Dark minimalist styles -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#171A24"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#2D3345"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="#252A3A"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#384058"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="#9BA3B8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <!-- Slider Style -->
        <Style TargetType="Slider">
            <Setter Property="Foreground" Value="#00F0FF"/>
            <Setter Property="Background" Value="#202535"/>
        </Style>

        <!-- Dark ComboBox Toggle Button Template -->
        <ControlTemplate x:Key="DarkComboBoxToggleButton" TargetType="ToggleButton">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="32" />
                </Grid.ColumnDefinitions>
                <Border x:Name="Border"
                        Grid.ColumnSpan="2"
                        CornerRadius="6"
                        Background="#171A24"
                        BorderBrush="#2D3345"
                        BorderThickness="1" />
                <Path x:Name="Arrow"
                      Grid.Column="1"
                      Fill="#00F0FF"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Data="M 0 0 L 5 5 L 10 0 Z" />
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Border" Property="BorderBrush" Value="#00F0FF" />
                    <Setter TargetName="Border" Property="Background" Value="#1D2230" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- Dark ComboBox Style -->
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="Background" Value="#171A24" />
            <Setter Property="BorderBrush" Value="#2D3345" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="MaxDropDownHeight" Value="320"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Name="ToggleButton"
                                          Template="{StaticResource DarkComboBoxToggleButton}"
                                          Focusable="false"
                                          IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press"/>
                            <ContentPresenter Name="ContentSite"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="12,8,34,8"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left">
                                <ContentPresenter.Resources>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="FontSize" Value="12"/>
                                    </Style>
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                            <Popup Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Grid Name="DropDown"
                                      SnapsToDevicePixels="True"
                                      MinWidth="{TemplateBinding ActualWidth}"
                                      MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border x:Name="DropDownBorder"
                                            Background="#12151F"
                                            BorderThickness="1.5"
                                            BorderBrush="#00F0FF"
                                            CornerRadius="6"
                                            Margin="0,4,0,0">
                                        <ScrollViewer Margin="4" SnapsToDevicePixels="True">
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark ComboBoxItem Style -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#ECEFF4"/>
            <Setter Property="Background" Value="#12151F"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}"
                                Margin="0,1">
                            <ContentPresenter Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#222C42"/>
                                <Setter Property="Foreground" Value="#00F0FF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#1A2438"/>
                                <Setter Property="Foreground" Value="#00F0FF"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ВЕРХНЯЯ ПАНЕЛЬ (Header) -->
        <Border Grid.Row="0" Background="#141722" CornerRadius="12" Padding="18,14" Margin="0,0,0,16" BorderBrush="#232838" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🏆" FontSize="26" Margin="0,0,12,0" VerticalAlignment="Center"/>
                    <StackPanel>
                        <TextBlock Text="STEAM ACHIEVEMENT OVERLAY &amp; TRACKER" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF"/>
                        <TextBlock Text="DirectX Exclusive Fullscreen Overlay • Safe Reverse-Engineered Hook • .NET 8" FontSize="11" Foreground="#00F0FF" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Регулятор громкости + Индикатор кэша + Очистка -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Регулятор громкости звука -->
                    <Border Background="#1C2130" CornerRadius="8" Padding="10,6" Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🔊" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="{Binding SoundVolume, StringFormat='{}{0}%'}" FontSize="12" FontWeight="Bold" Foreground="#00F0FF" Width="38" VerticalAlignment="Center"/>
                            <Slider Minimum="0" Maximum="100" Value="{Binding SoundVolume, Mode=TwoWay}" Width="85" VerticalAlignment="Center" Margin="2,0,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Индикатор кэша -->
                    <Border Background="#1C2130" CornerRadius="8" Padding="12,6" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="💾 Кэш: " FontSize="12" Foreground="#8C95A8"/>
                            <TextBlock Text="{Binding CacheSizeFormatted}" FontSize="12" FontWeight="Bold" Foreground="#00F0FF"/>
                        </StackPanel>
                    </Border>

                    <Button Content="🗑 Очистить кэш" Command="{Binding ClearCacheCommand}" Background="#3A1D24" BorderBrush="#682E3A" Foreground="#FF6B81"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ОСНОВНОЙ КОНТЕНТ (Sidebar + Tabs) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="330"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ЛЕВАЯ КОЛОНКА: Менеджер игр и кэша -->
            <Border Grid.Column="0" Background="#141722" CornerRadius="12" Padding="14" BorderBrush="#232838" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="ДОБАВИТЬ ИГРУ" FontSize="11" FontWeight="Bold" Foreground="#8C95A8" Margin="0,0,0,8"/>

                    <Grid Grid.Row="1" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding InputAppId, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0"/>
                        <Button Grid.Column="1" Content="+ Добавить" Command="{Binding AddGameCommand}" Background="#0066CC" BorderBrush="#0088FF"/>
                    </Grid>

                    <TextBlock Grid.Row="2" Text="КЭШИРОВАННЫЕ ИГРЫ" FontSize="11" FontWeight="Bold" Foreground="#8C95A8" Margin="0,4,0,8" VerticalAlignment="Top"/>

                    <ListBox Grid.Row="2"
                             ItemsSource="{Binding Games}"
                             SelectedItem="{Binding SelectedGame}"
                             Background="Transparent"
                             BorderThickness="0"
                             Margin="0,24,0,0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#1A1F2C" CornerRadius="8" Padding="10" Margin="0,0,0,8" BorderBrush="#282F44" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Превью обложки игры -->
                                        <Border Grid.Column="0" Width="72" Height="34" CornerRadius="4" ClipToBounds="True" Background="#111" Margin="0,0,10,0" BorderBrush="#33FFFFFF" BorderThickness="1">
                                            <Image Source="{Binding DisplayHeaderSource}" Stretch="UniformToFill"/>
                                        </Border>

                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="13" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding AppId, StringFormat='AppID: {0}'}" FontSize="11" Foreground="#8C95A8" Margin="0,1,0,3"/>
                                            <ProgressBar Value="{Binding CompletionPercentage, Mode=OneWay}" Maximum="100" Height="4" Background="#111" Foreground="#00F0FF"/>
                                            <TextBlock Text="{Binding CompletionPercentage, StringFormat='Прогресс: {0}%'}" FontSize="10" Foreground="#00F0FF" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Button Grid.Row="3" Content="Удалить выбранную игру" Command="{Binding DeleteGameCommand}" Background="#2B2125" BorderBrush="#4D333B" Margin="0,10,0,0"/>
                </Grid>
            </Border>

            <!-- ПРАВАЯ КОЛОНКА: Вкладки (Достижения / Античит / Песочница) -->
            <Border Grid.Column="2" Background="#141722" CornerRadius="12" Padding="16" BorderBrush="#232838" BorderThickness="1">
                <TabControl Background="Transparent" BorderThickness="0">

                    <!-- ВКЛАДКА 1: ДОСТИЖЕНИЯ -->
                    <TabItem Header="🎯 Достижения и Градация">
                        <Grid Margin="0,12,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Шапка выбранной игры с обложкой -->
                            <Border Grid.Row="0" Background="#1A1F2C" CornerRadius="10" Padding="14" Margin="0,0,0,12" BorderBrush="#2A3146" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Обложка игры -->
                                    <Border Grid.Column="0" Width="135" Height="63" CornerRadius="6" ClipToBounds="True" Background="#111" Margin="0,0,14,0" BorderBrush="#44FFFFFF" BorderThickness="1">
                                        <Image Source="{Binding SelectedGame.DisplayHeaderSource}" Stretch="UniformToFill"/>
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding SelectedGame.Name, FallbackValue='Игра не выбрана'}" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <TextBlock Text="{Binding SelectedGame.TotalAchievements, StringFormat='Всего: {0} шт.'}" FontSize="12" Foreground="#8C95A8" Margin="0,0,12,0"/>
                                            <TextBlock Text="{Binding SelectedGame.UnlockedCount, StringFormat='Разблокировано: {0}'}" FontSize="12" Foreground="#2ED573" FontWeight="Bold" Margin="0,0,8,0"/>
                                            <TextBlock Text="{Binding SelectedGame.CompletionPercentage, StringFormat='({0}% завершено)'}" FontSize="12" Foreground="#00F0FF" FontWeight="Bold" Margin="0,0,14,0"/>
                                        </StackPanel>
                                        <TextBlock Text="Бронза (>50%) • Серебро (15-50%) • Золото (&lt;15%) • Платина (100%)" FontSize="11" Foreground="#FFD700" Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="🌐 Перевести на русский" Command="{Binding TranslateGameCommand}" Background="#163826" BorderBrush="#2ED573" Foreground="#2ED573" Margin="0,0,8,0" Padding="12,8"/>
                                        <Button Content="🔄 Синхронизировать" Command="{Binding SyncGameCommand}" Background="#1C2E4A" BorderBrush="#0088FF" Foreground="#00F0FF" Margin="0,0,8,0" Padding="12,8"/>
                                        <Button Content="💎 Тест Платины (100%)" Command="{Binding TestRankCommand}" CommandParameter="Diamond" Background="#0A3A40" BorderBrush="#00F0FF" Foreground="#00F0FF" Padding="12,8"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Список ачивок -->
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding FilteredAchievements}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#171B26" CornerRadius="8" Padding="12" Margin="0,0,0,8" BorderBrush="{Binding CardBorderBrush}" BorderThickness="1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="48"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="140"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Иконка (кэшированная или CDN фолбэк) -->
                                                    <Border Grid.Column="0" Width="44" Height="44" CornerRadius="6" Background="#222" ClipToBounds="True" BorderBrush="{Binding UnlockStatusBorder}" BorderThickness="1">
                                                        <Image Source="{Binding DisplayIconSource}" Stretch="UniformToFill" Opacity="{Binding DisplayOpacity}"/>
                                                    </Border>

                                                    <!-- Инфо -->
                                                    <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" FontSize="13" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                                            <!-- Бейдж разблокировано / заблокировано -->
                                                            <Border Margin="8,0,0,0" CornerRadius="4" Padding="6,2" Background="{Binding UnlockStatusBg}" BorderBrush="{Binding UnlockStatusBorder}" BorderThickness="1" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding UnlockStatusText}" Foreground="{Binding UnlockStatusColor}" FontWeight="SemiBold" FontSize="10"/>
                                                            </Border>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding Description}" FontSize="11" Foreground="#959EAF" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                                                        <TextBlock Text="{Binding ApiName, StringFormat='API: {0}'}" FontSize="9" Foreground="#555E70"/>
                                                    </StackPanel>

                                                    <!-- Ранг и процент -->
                                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,14,0">
                                                        <Border CornerRadius="4" Padding="6,2" HorizontalAlignment="Right" Background="#1D2232">
                                                            <TextBlock Text="{Binding RankDisplayName}" Foreground="{Binding RankColor}" FontWeight="Bold" FontSize="11"/>
                                                        </Border>
                                                        <TextBlock Text="{Binding FormattedGlobalPercent}" FontSize="10" Foreground="#8C95A8" HorizontalAlignment="Right" Margin="0,2,0,0"/>
                                                    </StackPanel>

                                                    <!-- Кнопка мгновенного тестирования -->
                                                    <Button Grid.Column="3"
                                                            Content="🔔 Тест"
                                                            Command="{Binding DataContext.TestOverlayCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Background="#202636"
                                                            Padding="10,5"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </TabItem>

                    <!-- ВКЛАДКА 2: АНТИЧИТ И БЕЗОПАСНЫЙ ИНЖЕКТ -->
                    <TabItem Header="🛡 Безопасность и Инжектор">
                        <Grid Margin="0,12,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Выбор процесса с исправленным контрастным ComboBox -->
                            <Border Grid.Row="0" Background="#1A1F2C" CornerRadius="10" Padding="14" Margin="0,0,0,12" BorderBrush="#2A3146" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="Процесс игры: " VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#E0E6F0" Margin="0,0,10,0"/>

                                    <ComboBox Grid.Column="1"
                                              ItemsSource="{Binding RunningProcesses}"
                                              SelectedItem="{Binding SelectedProcess}"
                                              Margin="0,0,10,0">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="⚙ " Foreground="#00F0FF" FontSize="11" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding DisplayText}" FontSize="12" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>

                                    <Button Grid.Column="2" Content="🔄 Обновить" Command="{Binding RefreshProcessesCommand}" Margin="0,0,8,0"/>
                                    <Button Grid.Column="3" Content="🔍 Проверить безопасность" Command="{Binding EvaluateSafetyCommand}" Background="#1F352B" BorderBrush="#2ED573" Foreground="#2ED573" Margin="0,0,8,0"/>
                                    <Button Grid.Column="4" Content="🎯 Запустить отслеживание" Command="{Binding InjectHookCommand}" Background="#0066CC" BorderBrush="#0088FF" FontWeight="SemiBold"/>
                                </Grid>
                            </Border>

                            <!-- Карточка вердикта безопасности -->
                            <Border Grid.Row="1" Background="#161B26" CornerRadius="10" Padding="14" Margin="0,0,0,12" BorderBrush="#2A3146" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="СТАТУС ЗАЩИТЫ ОТ АНТИЧИТОВ (ANTI-BAN ENGINE)" FontSize="12" FontWeight="Bold" Foreground="#8C95A8"/>

                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding LastSafetyResult.Reason, FallbackValue='Нажмите [Проверить безопасность] для запуска аудита модулей EAC, BattlEye, Vanguard и флага VAC.'}"
                                                       FontSize="13" Foreground="#FFFFFF" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding LastSafetyResult.DetectedThreat, StringFormat='Обнаруженная угроза: {0}'}"
                                                       FontSize="12" Foreground="#FF4757" FontWeight="Bold" Margin="0,4,0,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding LastSafetyResult.IsSafe}" Value="False">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                            <Button Content="🔌 Отключить / Clean Unhook" Command="{Binding DetachHookCommand}" Background="#3A2026" BorderBrush="#682E3A" Foreground="#FF6B81"/>
                                            <TextBlock Text="🟢 Отслеживание активно" Foreground="#2ED573" FontWeight="Bold" FontSize="11" Margin="0,6,0,0" HorizontalAlignment="Right">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsInjected}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Логи терминала -->
                            <Border Grid.Row="2" Background="#0A0C10" CornerRadius="8" Padding="10" BorderBrush="#1C2130" BorderThickness="1">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="КОНСОЛЬ АУДИТА И ПЕРЕХВАТА ХУКА" FontSize="10" FontWeight="Bold" Foreground="#555E70" Margin="0,0,0,6"/>
                                    <ListBox Grid.Row="1"
                                             ItemsSource="{Binding ConsoleLogs}"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             FontFamily="Consolas"
                                             FontSize="11"
                                             Foreground="#00F0FF"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </TabItem>

                    <!-- ВКЛАДКА 3: ПЕСОЧНИЦА ОВЕРЛЕЯ И АУДИО -->
                    <TabItem Header="✨ Тестирование Оверлея и Аудио">
                        <Grid Margin="0,14,0,0">
                            <StackPanel>
                                <TextBlock Text="ИНТЕРАКТИВНОЕ ТЕСТИРОВАНИЕ ОВЕРЛЕЯ" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF"/>
                                <TextBlock Text="Нажмите кнопку любого ранга для проверки анимации Fade-in + Slide-down по центру экрана (Top-Center) и воспроизведения оригинальных звуков Xbox."
                                           FontSize="12" Foreground="#8C95A8" Margin="0,4,0,14"/>

                                <!-- Регулировка громкости аудио -->
                                <Border Background="#161B26" CornerRadius="10" Padding="16" Margin="0,0,0,16" BorderBrush="#262D3E" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                                            <TextBlock Text="🔊" FontSize="20" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <StackPanel>
                                                <TextBlock Text="ГРОМКОСТЬ ЗВУКА XBOX" FontWeight="Bold" FontSize="12" Foreground="#FFFFFF"/>
                                                <TextBlock Text="Официальные звуки Xbox 360 / Xbox One" FontSize="11" Foreground="#8C95A8"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <Slider Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding SoundVolume, Mode=TwoWay}" VerticalAlignment="Center" Margin="10,0"/>

                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding SoundVolume, StringFormat='{}{0}%'}" FontSize="14" FontWeight="Bold" Foreground="#00F0FF" Width="45" TextAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                            <Button Content="Тест звука" Command="{Binding TestRankCommand}" CommandParameter="Bronze" Background="#252A3A" Padding="12,6"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <UniformGrid Columns="2" Rows="2" Margin="0,0,0,18">
                                    <Button Content="🥉 Тест Бронзы (>50%)" Command="{Binding TestRankCommand}" CommandParameter="Bronze"
                                            Background="#2B1E17" BorderBrush="#CD7F32" Foreground="#CD7F32" Margin="6" Padding="14,16"/>

                                    <Button Content="🥈 Тест Серебра (15-50%)" Command="{Binding TestRankCommand}" CommandParameter="Silver"
                                            Background="#22252B" BorderBrush="#C0C0C0" Foreground="#C0C0C0" Margin="6" Padding="14,16"/>

                                    <Button Content="🥇 Тест Золота (&lt;15%)" Command="{Binding TestRankCommand}" CommandParameter="Gold"
                                            Background="#2B2717" BorderBrush="#FFD700" Foreground="#FFD700" Margin="6" Padding="14,16"/>

                                    <Button Content="💎 Тест Платины (100% Триггер)" Command="{Binding TestRankCommand}" CommandParameter="Diamond"
                                            Background="#0C2E33" BorderBrush="#00F0FF" Foreground="#00F0FF" Margin="6" Padding="14,16"/>
                                </UniformGrid>

                                <Border Background="#161B26" CornerRadius="10" Padding="14" BorderBrush="#262D3E" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="🎵 Аудиофайлы Xbox (Папка Sounds/):" FontWeight="Bold" FontSize="12" Foreground="#FFFFFF"/>
                                        <TextBlock Text="• standard_unlock.wav (Xbox 360 Achievement Chime) — для Бронзы, Серебра и Золота" FontSize="12" Foreground="#8C95A8" Margin="0,6,0,2"/>
                                        <TextBlock Text="• rare_platinum_unlock.wav (Xbox One Rare Diamond Fanfare) — для Платины (100% достижений)" FontSize="12" Foreground="#00F0FF"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </TabItem>

                </TabControl>
            </Border>
        </Grid>

        <!-- НИЖНЯЯ ПАНЕЛЬ СТАТУСА (Footer) -->
        <Border Grid.Row="2" Background="#141722" CornerRadius="8" Padding="12,6" Margin="0,12,0,0" BorderBrush="#232838" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" FontSize="12" Foreground="#8C95A8" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="Steam Achievement Overlay • C# (.NET 8)" FontSize="11" Foreground="#555E70" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
